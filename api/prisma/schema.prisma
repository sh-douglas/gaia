generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  SMO
  ADMIN
}

enum DoctorNoteStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model Employee {
  id                   String        @id @default(uuid()) @db.Uuid
  fullName             String
  cpf                  String        @unique
  email                String        @unique
  phone                String        @unique
  passwordHash         String
  active               Boolean       @default(true)
  role                 Role          @default(OPERATOR)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  authSessions         AuthSession[]
  submittedDoctorNotes DoctorNote[]  @relation("EmployeeSubmittedDoctorNotes")
  reviewedDoctorNotes  DoctorNote[]  @relation("EmployeeReviewedDoctorNotes")

  @@map("employees")
}

model DoctorNote {
  id          String           @id @default(uuid()) @db.Uuid
  issuedAt    DateTime
  submittedAt DateTime
  restDays    Int
  restEndsAt  DateTime
  employeeId  String           @db.Uuid
  smoId       String?          @db.Uuid
  status      DoctorNoteStatus @default(PENDING)
  doctorName  String
  crm         String
  clinic      String
  noteType    String
  cid         String
  observation String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  doctorNoteFile DoctorNoteFile[]

  employee Employee  @relation("EmployeeSubmittedDoctorNotes", fields: [employeeId], references: [id], onDelete: Restrict)
  smo      Employee? @relation("EmployeeReviewedDoctorNotes", fields: [smoId], references: [id], onDelete: Restrict)

  @@map("doctor_notes")
}

model DoctorNoteFile {
  id            String   @id @default(uuid()) @db.Uuid
  originalFile  String
  optimizedFile String?
  doctorNoteId  String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctorNote DoctorNote @relation(fields: [doctorNoteId], references: [id], onDelete: Restrict)

  @@map("doctor_note_files")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("auth_sessions")
}
